#!/bin/sh

# PROVIDE: cloudbsd_admin
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="cloudbsd_admin"
rcvar="cloudbsd_admin_enable"

load_rc_config $name

: ${cloudbsd_admin_enable:="NO"}
: ${cloudbsd_admin_user:="www"}
: ${cloudbsd_admin_group:="www"}
: ${cloudbsd_admin_dir:="/usr/local/www/cloudbsd-admin"}
: ${cloudbsd_admin_config:="/usr/local/etc/cloudbsd/admin-panel/config.json"}
: ${cloudbsd_admin_node:="/usr/local/bin/node24"}

pidfile="/var/run/cloudbsd-admin/${name}.pid"
procname="${cloudbsd_admin_node}"
command="/usr/sbin/daemon"
command_args="-f -P ${pidfile} -u ${cloudbsd_admin_user} ${cloudbsd_admin_node} ${cloudbsd_admin_dir}/server/dist/index.js"

start_precmd="cloudbsd_admin_prestart"
stop_precmd="cloudbsd_admin_check_running"
restart_precmd="cloudbsd_admin_check_running"

cloudbsd_admin_prestart()
{
    if [ ! -d "/var/run/cloudbsd-admin" ]; then
        mkdir -p /var/run/cloudbsd-admin
    fi
    chown -R ${cloudbsd_admin_user}:${cloudbsd_admin_group} /var/run/cloudbsd-admin
    
    # Ensure config exists or uses default
    if [ ! -f "${cloudbsd_admin_config}" ]; then
        warn "Config file ${cloudbsd_admin_config} not found, using internal defaults."
    fi
}

cloudbsd_admin_check_running()
{
    if ! check_process_running; then
        echo "${name} is not running."
        return 1
    fi
}

check_process_running()
{
    if [ -f "${pidfile}" ]; then
        _pid=$(cat "${pidfile}")
        if [ -n "${_pid}" ] && [ "${_pid}" -gt 0 ] && kill -0 "${_pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

run_rc_command "$1"
