{
  "name": "@cloudbsd/ui-admin",
  "version": "0.1.0",
  "description": "Admin-specific UI components for CloudBSD admin panel",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ResourceList": "./dist/components/ResourceList/index.js",
    "./ResourceModal": "./dist/components/ResourceModal/index.js",
    "./ConfirmationModal": "./dist/components/ConfirmationModal/index.js",
    "./ConsoleModal": "./dist/components/ConsoleModal/index.js",
    "./CustomPageSizeModal": "./dist/components/CustomPageSizeModal/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-i18next": ">=14.0.0",
    "i18next": ">=23.0.0",
    "tailwindcss": ">=3.4.0",
    "lucide-react": ">=0.400.0",
    "framer-motion": ">=11.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0",
    "tsup": "^8.0.0"
  },
  "keywords": ["cloudbsd", "ui", "admin", "components", "react", "tailwind"]
}